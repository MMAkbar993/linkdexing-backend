# ----------------------------------------------------------------------------
# Linkdexing - Backend (Express API)
# Template. Copy to .env (cp .env.example .env) and fill in the real values.
# Keep this file committed with EMPTY values only - never commit real secrets.
# ----------------------------------------------------------------------------

# Port the API listens on. Falls back to 4000 if empty (backend/app.js:12)
PORT=

# --- MongoDB (backend/app.js:35) --------------------------------------------
# Full connection string, including the database name and any options, e.g.
# mongodb+srv://<user>:<password>@cluster0.men9r.mongodb.net/<dbname>?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ : / ? # [ ] % etc).
MONGODB_URI=

# --- JSON Web Tokens --------------------------------------------------------
# Signs/verifies normal user tokens (src/api/v1/users/controller.js)
JWT_SECRET=
# Signs/verifies admin panel tokens (src/api/v1/admin/controller.js)
JWT_ADMIN_SECRET=

# --- Admin panel login (src/api/v1/admin/controller.js:20) ------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Universal password that logs in as any user (src/api/v1/users/controller.js:128)
# Leave empty in production unless you really need it.
MASTER_PASSWORD=
# Must also be "true" for MASTER_PASSWORD above to work at all. Two switches
# so it can't be left on by accident - never set this to true in production.
ENABLE_MASTER_PASSWORD=false

# --- CORS (backend/app.js) ---------------------------------------------------
# Comma-separated list of origins allowed to call this API, e.g.
# https://linkdexing.com,https://admin.linkdexing.com
# Leave empty in local dev to allow any origin (a warning is logged on start).
CORS_ORIGIN=

# --- Google reCAPTCHA v3 ----------------------------------------------------
# Server-side secret. Its public pair is REACT_APP_RECAPTCHA_SITE_KEY in frontend/.env
RECAPTCHA_SECRET_KEY=

# --- Sendinblue / Brevo (src/utils/sib.js) ----------------------------------
SIB_API_KEY=

# --- Links inside outgoing emails (src/api/v1/users/controller.js:374) ------
# No trailing slash, e.g. https://linkdexing.com
FRONTEND_URL=

# --- PayPal (src/services/paypal.js) -----------------------------------------
# "sandbox" or "live".
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook's page in the PayPal developer dashboard, once one is
# registered against a public HTTPS URL (localhost can't receive it).
PAYPAL_WEBHOOK_ID=
